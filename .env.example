# SOC Automation Platform Environment Configuration

# Threat Intelligence API Keys
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
ALIENVAULT_OTX_API_KEY=your_alienvault_otx_api_key_here

# Webhook Alert Destinations
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_discord_webhook_id/your_token
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your_slack_webhook

# Threshold Configurations
RISK_THRESHOLD_HIGH=50
RISK_THRESHOLD_CRITICAL=80

# App Server Configuration
FLASK_PORT=5000
LOG_LEVEL=INFO
